#!/bin/bash

set -e  # Exit immediately if any command returns a non-zero status
set -o pipefail  # Fail on errors in piped commands

log() {
    echo "$(date +'%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}"
}

export CXX_STD=17
export CC=$(type -p gcc)
export CXX=$(type -p g++)
BOOST_SETTINGS="link=static cxxflags='-std=c++${CXX_STD}'"
############################################################################################
#
############################################################################################
require_tools() {
    local missing=()
    for tool in cmake ninja wget; do
        if ! type -p "$tool" >/dev/null 2>&1; then
            missing+=("$tool")
        fi
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "Error: Missing required tools: ${missing[*]}" >&2
        exit 1
    fi
}

check_env_variables() {
    local error_msg=""
    if [[ -z "$CXX" ]]; then
        error_msg+="CXX is not set. It can be set using following command: export CXX=$(type -p g++)' -std=c++17' "
    fi

    if [[ -z "$CC" ]]; then
        error_msg+="CC is not set. It can be set using following command: export CXX=$(type -p gcc)" 
    fi

    if [[ -n "$error_msg" ]]; then
        echo -e "Error: ${error_msg} Please set the required environment variables before running the script." >&2
        exit 1
    fi
}

display_help() {
    echo "Usage: $0 [OPTIONS]"
    echo "Options:"
    echo "  -j <num_threads>    Set the number of threads for building (default: 4)"
    echo "  --install DIR     Installation directory (default: pwd)"
    echo "  --preset <ALL>    SMT configuration. ALL enables all SMTs (default: minimal configuration CUDD-Z3)"
    echo "  --help            Display this help message"
    echo ""
    echo "The installation of crave2uvm requires the libraries systemc and uvm-systemc, they are automatically installed by this script if the environment variables SYSTEMC_HOME and UVM_SYSTEMC_HOME are not set."
}


# Set default values
NUM_THREADS=4  
CMAKE_INSTALL_PREFIX="$(pwd)"
LOG_FILE="crave2uvm_build.log"
PRESET="CUDD-Z3"
# Truncate the log file before each run
> "${LOG_FILE}"

# Parse command-line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -j)
            NUM_THREADS="$2"
            shift 2
            ;;
        --install)
            if [[ -n "$2" ]]; then
                CMAKE_INSTALL_PREFIX="$2"
                shift 2
            else
                echo "Error: Argument for --install is missing." >&2
                exit 1
            fi
            ;;
        --preset)
            if [[ -n "$2" ]]; then
                PRESET="$2"
                shift 2
            else
                echo "Error: Argument for --preset is missing." >&2
                exit 1
            fi
            ;;
        --help)
            display_help
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'" >&2
            display_help
            exit 1
            ;;
    esac
done

require_tools
check_env_variables

if [[ -z "$BOOST_ROOT" ]]; then
    log "BOOST_ROOT is not set. Installing Boost..."
    DISTRO=$(lsb_release -i -s 2>/dev/null || true)
    [ "$DISTRO" == "Ubuntu" ] || BOOST_LIBDIR=--libdir=${CMAKE_INSTALL_PREFIX}/lib64
    export BOOST_LIB_EXCLUDE=python,wave,graph,graph_parallel

    BOOST_VERSION="${BOOST_VERSION:-1.85.0}"
    BOOST_TARBALL="boost_${BOOST_VERSION//./_}.tar.bz2"
    BOOST_DIR="boost_${BOOST_VERSION//./_}"
    if [ ! -d "$BOOST_DIR" ]; then
        [ -f "$BOOST_TARBALL" ] || wget "https://archives.boost.io/release/${BOOST_VERSION}/source/${BOOST_TARBALL}"
        tar xjf "$BOOST_TARBALL"
    fi
    (cd "$BOOST_DIR"; \
      ./bootstrap.sh --prefix=${CMAKE_INSTALL_PREFIX} ${BOOST_LIBDIR} --without-libraries=${BOOST_LIB_EXCLUDE};\
      ./b2 ${BOOST_SETTINGS} install) || exit 2

    export BOOST_ROOT=${CMAKE_INSTALL_PREFIX}
    log "Installation complete. BOOST_ROOT is $BOOST_ROOT"
fi

# Find or build SystemC and UVM-SystemC
if [[ -z "$SYSTEMC_HOME" ]]; then
    SYSTEMC_VERSION="${SYSTEMC_VERSION:-2.3.4}"

    log "Installing SystemC"
    wget https://github.com/accellera-official/systemc/archive/refs/tags/${SYSTEMC_VERSION}.tar.gz
    tar xvzf "${SYSTEMC_VERSION}.tar.gz"
    pushd "systemc-${SYSTEMC_VERSION}"
    cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_CXX_COMPILER=$CXX -DCMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX} -DCMAKE_CXX_STANDARD=$CXX_STD -DENABLE_PHASE_CALLBACKS_TRACING=OFF -DBUILD_SHARED_LIBS=OFF $CMAKE_ARGS .
    make -j "$NUM_THREADS"
    make install -j "$NUM_THREADS"

    popd  # go back to the original directory
    rm -rf "${SYSTEMC_VERSION}.tar.gz"

    export SYSTEMC_HOME=${CMAKE_INSTALL_PREFIX}
    log "Installation complete. SYSTEMC_HOME is $SYSTEMC_HOME"
fi

if [[ -z "$UVM_SYSTEMC_HOME" ]]; then
    UVM_SYSTEMC_VERSION="${UVM_SYSTEMC_VERSION:-1.0-beta4}"
    log "Installing UVM-SystemC"
    wget https://www.accellera.org/images/downloads/standards/systemc/uvm-systemc-${UVM_SYSTEMC_VERSION}.tar.gz
    tar xvzf uvm-systemc-${UVM_SYSTEMC_VERSION}.tar.gz
    pushd uvm-systemc-${UVM_SYSTEMC_VERSION}

    export CXXFLAGS=-std=c++17
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$SYSTEMC_HOME/lib-linux64:$SYSTEMC_HOME/lib-linux:$SYSTEMC_HOME/lib64

    # Configure and build
    config/bootstrap
    mkdir -p objdir
    pushd objdir
    ../configure --enable-debug --enable-shared=no --with-layout=unix --with-systemc=${SYSTEMC_HOME} --prefix=${CMAKE_INSTALL_PREFIX}

    log "Build UVM-SystemC using $NUM_THREADS thread(s)"
    make -j "$NUM_THREADS"
    make install -j "$NUM_THREADS"

    # cleanup
    popd  # go back to uvm-systemc-1.0-beta4 directory
    popd  # go back to the original directory
    rm -rf uvm-systemc-${UVM_SYSTEMC_VERSION}.tar.gz

    export UVM_SYSTEMC_HOME=${CMAKE_INSTALL_PREFIX}
    log "Installation complete. UVM_SYSTEMC_HOME is $UVM_SYSTEMC_HOME"
fi

# Run cmake preset
log "Running cmake preset..."
cmake --preset $PRESET -DCMAKE_INSTALL_PREFIX="$CMAKE_INSTALL_PREFIX" |& tee -a "${LOG_FILE}" || { log "Error: Failed to run cmake preset."; exit 1; }

log "Building and installing using CMake..."
cmake --build --preset $PRESET --target install --parallel "$NUM_THREADS" |& tee -a "${LOG_FILE}"
